# =============================================================================
# Guidenco — Environment Variables
# =============================================================================
# Two files are used:
#
#   .env        — Docker Compose only (Postgres + MinIO service config)
#   .env.local  — App secrets, loaded by Next.js and drizzle-kit
#
# Copy the relevant section to each file and fill in your values.
# Neither file should be committed to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# .env  (docker-compose service config)
# -----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=artiste
POSTGRES_PASSWORD=change_me
POSTGRES_DB=artiste_db
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me


# -----------------------------------------------------------------------------
# .env.local  (app secrets — Next.js + drizzle-kit)
# -----------------------------------------------------------------------------

# Database
POSTGRES_URL=postgresql://user:password@host:port/database

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change_me

# AI
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
SVG_MODEL=google/gemini-3.1-pro-preview

# Image search
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# SMTP — team invite emails
# Works with any SMTP provider (Resend, SendGrid, Postmark, etc.)
# Resend: host=smtp.resend.com, port=587, user=resend, pass=<api_key>
SMTP_SECURE=false
SMTP_FROM="Guidenco" <info@onvo.ai>
SMTP_HOST="smtp.resend.com"
SMTP_PASS="re_CBczJXev_25U5W2MKYsYZth99dw6kycf7"
SMTP_PORT=465
SMTP_USER="resend"
# S3 / MinIO — Design Warehouse file storage
# Dev: S3_ENDPOINT points to local MinIO (docker-compose.dev.yml)
# Prod: omit S3_ENDPOINT, use real AWS credentials
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=guidenco
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=us-east-1

# Stripe — billing (https://dashboard.stripe.com)
# Leave blank to disable billing; credit lockout will block all AI requests
# STRIPE_SECRET_KEY:      Dashboard → Developers → API keys → Secret key
# STRIPE_WEBHOOK_SECRET:  Dashboard → Developers → Webhooks → Signing secret
# STRIPE_PRO_PRICE_ID:    Dashboard → Products → Pro plan recurring price ID
# STRIPE_CREDIT_PACK_PRICE_ID: Dashboard → Products → Credit pack one-time price ID
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_CREDIT_PACK_PRICE_ID=price_...
