# ============================================================================
# Artiste Docker Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# Do NOT commit .env to version control - it contains secrets
# ============================================================================

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# Used by: docker-compose.yml (postgres service)
POSTGRES_USER=artiste
POSTGRES_PASSWORD=artiste_password_change_me
POSTGRES_DB=artiste_db
POSTGRES_PORT=5432

# ============================================================================
# DATABASE URL
# ============================================================================
# Format: postgresql://user:password@host:port/database
# For docker-compose.yml: Use 'postgres' as hostname (service name)
# For external database: Use your external host
POSTGRES_URL=postgresql://artiste:artiste_password_change_me@postgres:5432/artiste_db

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# AUTHENTICATION SECRET
# ============================================================================
# Generate a secure secret with: openssl rand -base64 32
# REQUIRED for production - do not use the default
BETTER_AUTH_SECRET=change_me_in_production_with_secure_secret

# ============================================================================
# OPTIONAL: EXTERNAL API KEYS
# ============================================================================
# OpenRouter API - For LLM/AI features
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model - LLM model id to use for /api/chat
# Example: google/gemini-2.5-pro
OPENROUTER_MODEL=google/gemini-2.5-pro

# Unsplash API - For image search/access
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ============================================================================
# PRODUCTION ENVIRONMENT EXAMPLES
# ============================================================================
# For production deployment, update these variables:
#
# NODE_ENV=production
# POSTGRES_URL=postgresql://user:secure_password@your-db-host:5432/artiste_db
# NEXT_PUBLIC_APP_URL=https://artiste.example.com
# BETTER_AUTH_SECRET=your_generated_secure_secret_here
# APP_PORT=3000
